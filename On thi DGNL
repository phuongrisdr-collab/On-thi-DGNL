        function renderNavigator() {
            const navContainer = document.getElementById('question-navigator');
            navContainer.innerHTML = filteredQuestions.map((q, idx) => {
                const state = userProgress[q.id];
                const isCurrent = idx === currentIndex;
                const isSaq = q.type === 'saq';

                let btnClass = "relative px-2.5 h-8 rounded-lg font-mono text-xs font-bold flex items-center justify-center space-x-1 transition-all-fast flex-shrink-0 border ";

                if (state.checked) {
                    const isPassed = isSaq ? (state.selfPassed === true) : (state.selected === q.correct_answer);
                    if (isPassed) {
                        btnClass += "bg-emerald-600 text-white border-emerald-400 ";
                    } else {
                        btnClass += "bg-rose-600 text-white border-rose-400 ";
                    }
                } else if (isCurrent) {
                    btnClass += "bg-teal-600 text-white border-teal-300 ";
                } else if ((isSaq && state.text.trim() !== "") || (!isSaq && state.selected)) {
                    btnClass += "bg-slate-600 text-white border-slate-500 ";
                } else {
                    btnClass += "bg-navy-800 text-slate-300 border-slate-700 hover:bg-slate-700 ";
                }

                if (isCurrent) {
                    btnClass += " ring-2 ring-amber-300 ";
                }

                const typeIcon = isSaq 
                    ? `<i class="fa-solid fa-pen-nib text-[9px] opacity-80"></i>` 
                    : `<i class="fa-solid fa-list-ul text-[9px] opacity-80"></i>`;

                const flagDot = state.flagged 
                    ? `<span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-amber-400 rounded-full border border-navy-950"></span>` 
                    : '';

                return `
                    <button onclick="jumpToQuestion(${idx})" class="${btnClass}" title="Câu ${idx + 1} (${isSaq ? 'Tự luận ngắn' : 'Trắc nghiệm'}) - ${q.specialty}">
                        <span>${idx + 1}</span>
                        ${typeIcon}
                        ${flagDot}
                    </button>
                `;
            }).join('');
        }

        function updateLiveScoreBadge() {
            let checkedCount = 0;
            let passedCount = 0;

            allQuestions.forEach(q => {
                const st = userProgress[q.id];
                if (st && st.checked) {
                    checkedCount++;
                    const isPassed = q.type === 'saq' ? (st.selfPassed === true) : (st.selected === q.correct_answer);
                    if (isPassed) passedCount++;
                }
            });

            document.getElementById('live-score-pill').textContent = `Đã đạt: ${passedCount}/${checkedCount}`;
        }

        // =========================================================================
        // 5. TƯƠNG TÁC NGƯỜI DÙNG (MCQ, SAQ, GỢI Ý, BỘ LỌC)
        // =========================================================================
        function selectMcqOption(optionKey) {
            const q = filteredQuestions[currentIndex];
            if (q.type !== 'mcq') return;
            const state = userProgress[q.id];
            if (state.checked) return;

            state.selected = optionKey;
            state.eliminated = state.eliminated.filter(k => k !== optionKey);
            renderCurrentQuestion();
        }

        function toggleEliminateOption(event, optionKey) {
            event.preventDefault();
            event.stopPropagation();

            const q = filteredQuestions[currentIndex];
            if (q.type !== 'mcq') return;
            const state = userProgress[q.id];
            if (state.checked) return;

            if (state.eliminated.includes(optionKey)) {
                state.eliminated = state.eliminated.filter(k => k !== optionKey);
            } else {
                state.eliminated.push(optionKey);
                if (state.selected === optionKey) state.selected = null;
            }
            renderCurrentQuestion();
        }

        function handleSaqInput(value) {
            const q = filteredQuestions[currentIndex];
            userProgress[q.id].text = value;
            renderNavigator();
        }

        function checkCurrentAnswer() {
            const q = filteredQuestions[currentIndex];
            const state = userProgress[q.id];

            if (q.type === 'mcq') {
                if (!state.selected) {
                    showToast("Vui lòng chọn một phương án (A, B, C hoặc D) trước khi kiểm tra!", "warning");
                    return;
                }
                state.checked = true;
            } else {
                // SAQ grading
                if (!state.text || state.text.trim().length < 2) {
                    showToast("Vui lòng nhập câu trả lời tự luận ngắn trước khi đối chiếu đáp án!", "warning");
                    document.getElementById('saq-user-input').focus();
                    return;
                }
                state.checked = true;

                // Auto-suggest pass/fail based on keyword match (>= 50% keywords matched)
                if (q.keywords && q.keywords.length > 0) {
                    const lowerInput = state.text.toLowerCase();
                    const matchedCount = q.keywords.filter(kw => lowerInput.includes(kw.toLowerCase())).length;
                    state.selfPassed = (matchedCount / q.keywords.length) >= 0.5;
                } else {
                    state.selfPassed = true;
                }
            }

            renderCurrentQuestion();

            if (window.innerWidth < 1024) {
                document.getElementById('explanation-box').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        function setSaqSelfGrade(passed) {
            const q = filteredQuestions[currentIndex];
            if (q.type !== 'saq') return;
            userProgress[q.id].selfPassed = passed;
            renderCurrentQuestion();
            showToast(passed ? "Đã ghi nhận: Đạt yêu cầu!" : "Đã ghi nhận: Cần ôn tập lại câu này.", passed ? "info" : "warning");
        }

        function retryCurrentQuestion() {
            const q = filteredQuestions[currentIndex];
            userProgress[q.id] = {
                selected: null,
                eliminated: [],
                text: "",
                checked: false,
                selfPassed: null,
                flagged: userProgress[q.id].flagged
            };
            renderCurrentQuestion();
            showToast("Đã làm mới câu hỏi hiện tại.", "info");
        }

        function toggleClinicalHint() {
            const q = filteredQuestions[currentIndex];
            showHint = !showHint;
            updateHintBoxUI(q);
        }

        function updateHintBoxUI(q) {
            const hintBox = document.getElementById('clinical-hint-box');
            const hintText = document.getElementById('clinical-hint-text');
            const hintBtn = document.getElementById('btn-hint');

            if (showHint) {
                hintText.textContent = q.hint || "Hãy phân tích kỹ các triệu chứng cơ năng, thực thể và các chỉ số xét nghiệm bất thường ở cột bên trái.";
                hintBox.classList.remove('hidden');
                hintBtn.classList.add('bg-amber-200', 'border-amber-400');
            } else {
                hintBox.classList.add('hidden');
                hintBtn.classList.remove('bg-amber-200', 'border-amber-400');
            }
        }

        function toggleHighlightAbnormal() {
            highlightAbnormal = !highlightAbnormal;
            renderLabsTable(filteredQuestions[currentIndex]);
        }

        function toggleFlagCurrent() {
            const q = filteredQuestions[currentIndex];
            userProgress[q.id].flagged = !userProgress[q.id].flagged;
            renderCurrentQuestion();
        }

        function prevQuestion() {
            if (currentIndex > 0) {
                currentIndex--;
                renderCurrentQuestion();
                resetScrollPositions();
            }
        }

        function nextQuestion() {
            if (currentIndex < filteredQuestions.length - 1) {
                currentIndex++;
                renderCurrentQuestion();
                resetScrollPositions();
            }
        }

        function jumpToQuestion(index) {
            currentIndex = index;
            renderCurrentQuestion();
            resetScrollPositions();
        }

        function resetScrollPositions() {
            document.getElementById('vignette-pane').scrollTop = 0;
            document.getElementById('question-pane').scrollTop = 0;
        }

        // =========================================================================
        // 6. BỘ LỌC CHUYÊN KHOA & DẠNG CÂU HỎI
        // =========================================================================
        function applyFilters() {
            const specVal = document.getElementById('specialty-filter').value;
            const typeVal = document.getElementById('type-filter').value;

            const result = allQuestions.filter(q => {
                const matchSpec = (specVal === 'ALL') || (q.specialty === specVal);
                const matchType = (typeVal === 'ALL') || (q.type === typeVal);
                return matchSpec && matchType;
            });

            if (result.length === 0) {
                showToast("Không tìm thấy câu hỏi phù hợp với bộ lọc hiện tại.", "warning");
                document.getElementById('specialty-filter').value = 'ALL';
                document.getElementById('type-filter').value = 'ALL';
                filteredQuestions = [...allQuestions];
            } else {
                filteredQuestions = result;
            }

            currentIndex = 0;
            renderCurrentQuestion();
        }

        function changeFontSize(delta) {
            if (delta === 0) fontSizeLevel = 0;
            else fontSizeLevel = Math.max(-1, Math.min(2, fontSizeLevel + delta));

            const container = document.getElementById('vignette-content');
            container.classList.remove('text-sm', 'text-base', 'text-lg', 'text-xl');
            
            if (fontSizeLevel === -1) container.classList.add('text-sm');
            else if (fontSizeLevel === 0) container.classList.add('text-base');
            else if (fontSizeLevel === 1) container.classList.add('text-lg');
            else if (fontSizeLevel === 2) container.classList.add('text-xl');
        }

        // =========================================================================
        // 7. ĐỒNG HỒ BẤM GIỜ LUYỆN TẬP (STOPWATCH)
        // =========================================================================
        function startStopwatch() {
            clearInterval(stopwatchInterval);
            stopwatchInterval = setInterval(() => {
                if (!isStopwatchPaused) {
                    elapsedSeconds++;
                    updateStopwatchDisplay();
                }
            }, 1000);
        }

        function updateStopwatchDisplay() {
            const mins = Math.floor(elapsedSeconds / 60);
            const secs = elapsedSeconds % 60;
            document.getElementById('stopwatch-display').textContent = 
                `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        function toggleStopwatch() {
            isStopwatchPaused = !isStopwatchPaused;
            const btn = document.getElementById('btn-timer-toggle');
            btn.innerHTML = isStopwatchPaused ? `<i class="fa-solid fa-play text-emerald-400"></i>` : `<i class="fa-solid fa-pause"></i>`;
            showToast(isStopwatchPaused ? "Đã tạm dừng đồng hồ luyện tập" : "Tiếp tục tính giờ", "info");
        }

        // =========================================================================
        // 8. MÀN HÌNH TỔNG KẾT LUYỆN THI (REVIEW DASHBOARD)
        // =========================================================================
        function openReviewDashboard() {
            let totalPassed = 0;
            let mcqTotal = 0, mcqPassed = 0;
            let saqTotal = 0, saqPassed = 0;
            const specStats = {};
            let wrongCount = 0;

            allQuestions.forEach(q => {
                const st = userProgress[q.id];
                const isSaq = q.type === 'saq';
                const isPassed = st.checked && (isSaq ? (st.selfPassed === true) : (st.selected === q.correct_answer));

                if (isPassed) totalPassed++;
                if (st.checked && !isPassed) wrongCount++;

                if (isSaq) {
                    saqTotal++;
                    if (isPassed) saqPassed++;
                } else {
                    mcqTotal++;
                    if (isPassed) mcqPassed++;
                }

                const spec = q.specialty || "Khác";
                if (!specStats[spec]) specStats[spec] = { total: 0, passed: 0 };
                specStats[spec].total++;
                if (isPassed) specStats[spec].passed++;
            });

            const total = allQuestions.length;
            const pct = total > 0 ? Math.round((totalPassed / total) * 100) : 0;

            document.getElementById('dash-total-score').textContent = `${totalPassed}/${total}`;
            document.getElementById('dash-total-percent').textContent = `${pct}%`;
            document.getElementById('dash-mcq-score').textContent = `${mcqPassed}/${mcqTotal}`;
            document.getElementById('dash-saq-score').textContent = `${saqPassed}/${saqTotal}`;

            const mins = Math.floor(elapsedSeconds / 60);
            const secs = elapsedSeconds % 60;
            document.getElementById('dash-time-spent').textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

            // Render Specialty Breakdown
            const breakdownEl = document.getElementById('dash-specialty-breakdown');
            breakdownEl.innerHTML = Object.entries(specStats).map(([spec, stat]) => {
                const specPct = Math.round((stat.passed / stat.total) * 100);
                let barColor = "bg-teal-600";
                if (specPct < 50) barColor = "bg-rose-500";
                else if (specPct < 75) barColor = "bg-amber-500";
                else barColor = "bg-emerald-500";

                return `
                    <div>
                        <div class="flex justify-between text-xs font-semibold mb-1">
                            <span class="text-slate-700">${spec}</span>
                            <span class="text-slate-600">${stat.passed}/${stat.total} câu đạt (${specPct}%)</span>
                        </div>
                        <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
                            <div class="${barColor} h-2.5 rounded-full transition-all duration-500" style="width: ${specPct}%"></div>
                        </div>
                    </div>
                `;
            }).join('');

            // Enable/disable retry wrong button
            const retryWrongBtn = document.getElementById('btn-retry-wrong');
            if (wrongCount > 0) {
                retryWrongBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                retryWrongBtn.disabled = false;
                retryWrongBtn.innerHTML = `<i class="fa-solid fa-fire-flame-curved mr-1.5"></i>Luyện lại ${wrongCount} câu chưa đạt`;
            } else {
                retryWrongBtn.classList.add('opacity-50', 'cursor-not-allowed');
                retryWrongBtn.disabled = true;
                retryWrongBtn.innerHTML = `<i class="fa-solid fa-check mr-1.5"></i>Không có câu sai`;
            }

            openModal('dashboard-modal');
        }

        function practiceWrongQuestions() {
            const wrongList = allQuestions.filter(q => {
                const st = userProgress[q.id];
                if (!st.checked) return false;
                const isPassed = q.type === 'saq' ? (st.selfPassed === true) : (st.selected === q.correct_answer);
                return !isPassed;
            });

            if (wrongList.length === 0) return;

            // Reset progress for those wrong questions
            wrongList.forEach(q => {
                userProgress[q.id] = {
                    selected: null,
                    eliminated: [],
                    text: "",
                    checked: false,
                    selfPassed: null,
                    flagged: true
                };
            });

            filteredQuestions = wrongList;
            currentIndex = 0;
            closeModal('dashboard-modal');
            renderCurrentQuestion();
            showToast(`Đang luyện lại ${wrongList.length} câu chưa đạt yêu cầu!`, "info");
        }

