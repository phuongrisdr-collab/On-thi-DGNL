<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luyện thi Đánh giá Năng lực Y khoa - MCQ & Tự luận ngắn (SAQ)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        navy: {
                            800: '#1e3a5f',
                            900: '#0f2537',
                            950: '#091724',
                        },
                        teal: {
                            600: '#0d9488',
                            700: '#0f766e',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom scrollbar for comfortable clinical reading */
        ::-webkit-scrollbar {
            width: 7px;
            height: 7px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Strikethrough styling for eliminated MCQ options */
        .option-eliminated .option-text {
            text-decoration: line-through;
            color: #94a3b8;
        }
        .option-eliminated {
            opacity: 0.65;
            background-color: #f8fafc !important;
        }

        .transition-all-fast {
            transition: all 0.15s ease-in-out;
        }

        ::selection {
            background-color: #fef08a;
            color: #0f172a;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased flex flex-col min-h-screen lg:h-screen lg:overflow-hidden">

    <!-- TOP HEADER (Study & Practice Focused) -->
    <header class="bg-navy-900 text-white shadow-md z-30 flex-shrink-0 border-b border-navy-800">
        <div class="max-w-full mx-auto px-3 sm:px-5 py-2.5 flex flex-wrap items-center justify-between gap-2">
            
            <!-- Left: Brand & Progress -->
            <div class="flex items-center space-x-3">
                <div class="bg-teal-600 p-2 rounded-xl flex items-center justify-center shadow-inner">
                    <i class="fa-solid fa-user-doctor text-white text-lg"></i>
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <h1 class="font-bold text-sm sm:text-base tracking-tight leading-tight text-white">
                            Luyện thi Đánh giá Năng lực Y khoa
                        </h1>
                        <span class="hidden sm:inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-teal-500/20 text-teal-300 border border-teal-500/30">
                            Chế độ Luyện thi
                        </span>
                    </div>
                    <div class="flex items-center space-x-2 text-xs text-slate-300 mt-0.5">
                        <span id="question-counter" class="font-semibold text-teal-300">Câu 1 / 8</span>
                        <span>•</span>
                        <span id="current-q-id" class="font-mono text-slate-400">ID: #NOI-01</span>
                        <span>•</span>
                        <span id="live-score-pill" class="text-emerald-300 font-medium">Đã đạt: 0/0</span>
                    </div>
                </div>
            </div>

            <!-- Center Controls: Specialty Filter & Question Type Filter -->
            <div class="flex flex-wrap items-center gap-2 order-3 lg:order-2 w-full lg:w-auto justify-between lg:justify-center border-t lg:border-t-0 border-navy-800 pt-2 lg:pt-0">
                <!-- Specialty Filter -->
                <div class="flex items-center bg-navy-800 rounded-lg px-2.5 py-1.5 border border-slate-700">
                    <i class="fa-solid fa-hospital-user text-teal-400 text-xs mr-1.5"></i>
                    <select id="specialty-filter" onchange="applyFilters()" class="bg-transparent text-xs text-white font-medium focus:outline-none cursor-pointer">
                        <option value="ALL" class="bg-navy-900 text-white">Tất cả chuyên khoa</option>
                        <option value="Nội khoa" class="bg-navy-900 text-white">Nội khoa</option>
                        <option value="Ngoại khoa" class="bg-navy-900 text-white">Ngoại khoa</option>
                        <option value="Sản phụ khoa" class="bg-navy-900 text-white">Sản phụ khoa</option>
                        <option value="Nhi khoa" class="bg-navy-900 text-white">Nhi khoa</option>
                    </select>
                </div>

                <!-- Question Type Filter (All / MCQ / SAQ) -->
                <div class="flex items-center bg-navy-800 rounded-lg px-2.5 py-1.5 border border-slate-700">
                    <i class="fa-solid fa-layer-group text-amber-400 text-xs mr-1.5"></i>
                    <select id="type-filter" onchange="applyFilters()" class="bg-transparent text-xs text-white font-medium focus:outline-none cursor-pointer">
                        <option value="ALL" class="bg-navy-900 text-white">Tất cả dạng câu (MCQ + Tự luận)</option>
                        <option value="mcq" class="bg-navy-900 text-white">Chỉ Trắc nghiệm (MCQ)</option>
                        <option value="saq" class="bg-navy-900 text-white">Chỉ Tự luận ngắn (SAQ)</option>
                    </select>
                </div>

                <!-- Utility Buttons: Lab Values & Import JSON -->
                <div class="flex items-center gap-1.5">
                    <button onclick="openModal('lab-modal')" class="bg-navy-800 hover:bg-slate-700 text-slate-200 border border-slate-600 px-2.5 py-1.5 rounded-lg text-xs font-medium flex items-center transition-all-fast" title="Tra cứu giá trị tham chiếu xét nghiệm">
                        <i class="fa-solid fa-flask-vial text-teal-400 mr-1.5"></i>
                        <span class="hidden sm:inline">Giá trị tham chiếu</span>
                        <span class="sm:hidden">Labs</span>
                    </button>
                    <button onclick="openModal('import-modal')" class="bg-navy-800 hover:bg-slate-700 text-slate-200 border border-slate-600 px-2.5 py-1.5 rounded-lg text-xs font-medium flex items-center transition-all-fast" title="Nhập bộ câu hỏi JSON từ AI">
                        <i class="fa-solid fa-file-import text-amber-400 mr-1.5"></i>
                        <span class="hidden sm:inline">Nhập đề JSON</span>
                        <span class="sm:hidden">JSON</span>
                    </button>
                </div>
            </div>

            <!-- Right: Study Stopwatch & Review Dashboard Button -->
            <div class="flex items-center space-x-2 order-2 lg:order-3">
                <!-- Study Stopwatch (Count-up for practice pacing) -->
                <div class="hidden sm:flex items-center bg-navy-950 border border-slate-700 rounded-lg px-2.5 py-1.5" title="Thời gian luyện tập">
                    <i class="fa-regular fa-clock text-teal-400 text-xs mr-1.5"></i>
                    <span id="stopwatch-display" class="font-mono text-xs font-semibold text-white tracking-wider">00:00</span>
                    <button id="btn-timer-toggle" onclick="toggleStopwatch()" class="ml-2 text-slate-400 hover:text-white text-xs" title="Tạm dừng / Tiếp tục">
                        <i class="fa-solid fa-pause"></i>
                    </button>
                </div>

                <!-- Summary Dashboard Button -->
                <button onclick="openReviewDashboard()" class="bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg shadow transition-all-fast flex items-center">
                    <i class="fa-solid fa-chart-pie mr-1.5"></i>
                    <span>Tổng kết luyện thi</span>
                </button>
            </div>
        </div>

        <!-- TOP QUESTION NAVIGATOR STRIP -->
        <div class="bg-navy-950/90 border-t border-navy-800 px-3 sm:px-5 py-2 flex flex-col sm:flex-row items-center justify-between gap-2">
            <div class="flex items-center space-x-1.5 overflow-x-auto max-w-full py-0.5" id="question-navigator">
                <!-- Dynamic question pills injected here -->
            </div>

            <!-- Legend -->
            <div class="flex items-center space-x-3 text-[11px] text-slate-400 flex-shrink-0">
                <span class="flex items-center"><i class="fa-solid fa-list-ul text-sky-400 mr-1 text-[10px]"></i>Trắc nghiệm</span>
                <span class="flex items-center"><i class="fa-solid fa-pen-nib text-purple-400 mr-1 text-[10px]"></i>Tự luận</span>
                <span class="text-slate-600">|</span>
                <span class="flex items-center"><span class="w-2.5 h-2.5 rounded-sm bg-emerald-500 inline-block mr-1"></span>Đạt</span>
                <span class="flex items-center"><span class="w-2.5 h-2.5 rounded-sm bg-rose-500 inline-block mr-1"></span>Chưa đạt</span>
                <span class="flex items-center"><i class="fa-solid fa-flag text-amber-400 mr-1"></i>Cắm cờ</span>
            </div>
        </div>
    </header>

    <!-- SUB-TOOLBAR: Flag, Clinical Hint & Font Size Controls -->
    <div class="bg-slate-200 border-b border-slate-300 px-4 py-1.5 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600 flex-shrink-0">
        <div class="flex items-center space-x-2">
            <!-- Flag Question -->
            <button id="btn-flag" onclick="toggleFlagCurrent()" class="flex items-center space-x-1.5 px-2.5 py-1 rounded-md border border-slate-300 bg-white hover:bg-amber-50 text-slate-700 font-medium transition-all-fast">
                <i class="fa-regular fa-flag text-amber-600"></i>
                <span>Cắm cờ xem lại</span>
            </button>

            <!-- Clinical Hint Toggle -->
            <button id="btn-hint" onclick="toggleClinicalHint()" class="flex items-center space-x-1.5 px-2.5 py-1 rounded-md border border-amber-300 bg-amber-50 hover:bg-amber-100 text-amber-800 font-semibold transition-all-fast">
                <i class="fa-regular fa-lightbulb text-amber-600"></i>
                <span>Gợi ý lâm sàng</span>
            </button>
        </div>

        <!-- Font size adjusters for Clinical Vignette -->
        <div class="flex items-center space-x-1.5">
            <span class="text-slate-500 hidden sm:inline">Cỡ chữ ca bệnh:</span>
            <button onclick="changeFontSize(-1)" class="w-7 h-7 bg-white border border-slate-300 rounded hover:bg-slate-100 font-bold text-slate-700 flex items-center justify-center" title="Giảm cỡ chữ">A-</button>
            <button onclick="changeFontSize(0)" class="w-7 h-7 bg-white border border-slate-300 rounded hover:bg-slate-100 font-medium text-slate-700 flex items-center justify-center" title="Cỡ chữ mặc định">A</button>
            <button onclick="changeFontSize(1)" class="w-7 h-7 bg-white border border-slate-300 rounded hover:bg-slate-100 font-bold text-slate-700 flex items-center justify-center" title="Tăng cỡ chữ">A+</button>
        </div>
    </div>

    <!-- MAIN SPLIT-SCREEN WORKSPACE -->
    <main class="flex-1 flex flex-col lg:flex-row lg:overflow-hidden">
        
        <!-- LEFT COLUMN: CLINICAL VIGNETTE & LABS -->
        <section id="vignette-pane" class="w-full lg:w-1/2 bg-white border-b lg:border-b-0 lg:border-r border-slate-300 lg:overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="max-w-3xl mx-auto">
                <!-- Specialty & Question Type Badges -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4 pb-3 border-b border-slate-200">
                    <div class="flex flex-wrap items-center gap-2">
                        <span id="q-specialty-badge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-50 text-teal-700 border border-teal-200">
                            Nội khoa
                        </span>
                        <span id="q-type-badge" class="px-2.5 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                            <i class="fa-solid fa-list-ul mr-1"></i>Trắc nghiệm (MCQ)
                        </span>
                    </div>
                    <span class="text-xs text-slate-500 font-mono" id="q-topic-tag">Chủ đề: Tim mạch</span>
                </div>

                <!-- Vignette Text Container -->
                <div id="vignette-content" class="text-base leading-relaxed text-slate-800 space-y-4">
                    <!-- Dynamic clinical history injected here -->
                </div>

                <!-- Laboratory / Imaging Results Table with Highlight Toggle -->
                <div id="labs-container" class="mt-6 bg-slate-50 border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                    <div class="bg-slate-100 px-4 py-2.5 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center">
                            <i class="fa-solid fa-microscope text-teal-700 mr-2"></i>
                            Cận lâm sàng & Thăm dò
                        </h3>
                        <div class="flex items-center space-x-3">
                            <!-- Toggle Highlight Abnormal Values -->
                            <button id="btn-toggle-abnormal" onclick="toggleHighlightAbnormal()" class="text-xs px-2.5 py-1 rounded-md border font-medium transition-all-fast flex items-center bg-rose-50 border-rose-200 text-rose-700">
                                <i class="fa-solid fa-highlighter mr-1.5"></i>
                                <span id="highlight-abnormal-text">Đang tô màu bất thường</span>
                            </button>
                            <button onclick="openModal('lab-modal')" class="text-xs text-teal-700 hover:underline font-semibold">
                                Bảng tham chiếu
                            </button>
                        </div>
                    </div>
                    <div class="p-0 overflow-x-auto">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-slate-50 text-slate-500 text-xs uppercase border-b border-slate-200">
                                <tr>
                                    <th class="px-4 py-2 font-semibold">Xét nghiệm / Thăm dò</th>
                                    <th class="px-4 py-2 font-semibold">Kết quả</th>
                                    <th class="px-4 py-2 font-semibold hidden sm:table-cell">Tham chiếu</th>
                                </tr>
                            </thead>
                            <tbody id="labs-table-body" class="divide-y divide-slate-200 font-mono text-xs sm:text-sm">
                                <!-- Dynamic lab rows injected here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <!-- RIGHT COLUMN: LEAD-IN QUESTION, INTERACTION AREA (MCQ or SAQ) & EXPLANATION -->
        <section id="question-pane" class="w-full lg:w-1/2 bg-slate-50 lg:overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col justify-between">
            <div class="max-w-3xl mx-auto w-full space-y-5">
                
                <!-- Clinical Hint Callout (Hidden by default) -->
                <div id="clinical-hint-box" class="hidden bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl shadow-sm text-sm text-amber-950">
                    <div class="flex items-start space-x-2.5">
                        <i class="fa-solid fa-lightbulb text-amber-600 mt-0.5"></i>
                        <div>
                            <span class="font-bold uppercase text-xs tracking-wider text-amber-800 block mb-1">Gợi ý định hướng tư duy lâm sàng:</span>
                            <p id="clinical-hint-text" class="leading-relaxed"></p>
                        </div>
                    </div>
                </div>

                <!-- Lead-in Question Card -->
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <div class="flex items-start space-x-3">
                        <span id="question-pill-label" class="bg-navy-900 text-white font-bold text-xs px-2.5 py-1 rounded mt-0.5 flex-shrink-0">CÂU HỎI</span>
                        <h2 id="lead-in-question" class="text-base sm:text-lg font-bold text-navy-950 leading-snug">
                            <!-- Dynamic lead-in question -->
                        </h2>
                    </div>
                </div>

                <!-- AREA A: MULTIPLE CHOICE OPTIONS (Shown when type === 'mcq') -->
                <div id="mcq-interaction-area" class="space-y-3">
                    <div class="flex items-center justify-between text-xs text-slate-500 px-1">
                        <span>Chọn 1 phương án đúng nhất:</span>
                        <span class="hidden sm:inline"><i class="fa-solid fa-computer-mouse mr-1"></i>Chuột phải hoặc bấm <i class="fa-solid fa-strikethrough mx-0.5"></i> để loại trừ</span>
                    </div>
                    <div id="options-list" class="space-y-3">
                        <!-- Dynamic option buttons A, B, C, D -->
                    </div>
                </div>

                <!-- AREA B: SHORT ANSWER INPUT (Shown when type === 'saq') -->
                <div id="saq-interaction-area" class="hidden space-y-3">
                    <div class="bg-white p-5 rounded-xl border-2 border-purple-200 shadow-sm space-y-3">
                        <div class="flex items-center justify-between">
                            <label for="saq-user-input" class="text-xs font-bold uppercase tracking-wider text-purple-800 flex items-center">
                                <i class="fa-solid fa-pen-to-square mr-1.5"></i>Câu trả lời của bạn (Tự luận ngắn)
                            </label>
                            <span id="saq-prompt-hint" class="text-xs text-slate-400">Nhập ngắn gọn, súc tích các ý chính</span>
                        </div>
                        <textarea id="saq-user-input" rows="4" oninput="handleSaqInput(this.value)" placeholder="Nhập chẩn đoán xác định, xét nghiệm đầu tay hoặc phác đồ xử trí của bạn tại đây..." class="w-full p-3.5 text-sm sm:text-base text-slate-800 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-purple-600 focus:bg-white transition-colors"></textarea>
                        
                        <!-- Keyword Match Live Feedback (Shown after grading) -->
                        <div id="saq-keyword-feedback" class="hidden pt-2 border-t border-slate-100">
                            <div class="text-xs font-semibold text-slate-600 mb-1.5">Đối chiếu từ khóa chuyên môn tự động:</div>
                            <div id="saq-keyword-badges" class="flex flex-wrap gap-1.5">
                                <!-- Dynamic matched/missed keyword chips -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons Row -->
                <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
                    <div class="flex items-center space-x-2">
                        <button id="btn-prev" onclick="prevQuestion()" class="px-4 py-2.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 font-medium text-sm transition-all-fast flex items-center disabled:opacity-40 disabled:cursor-not-allowed">
                            <i class="fa-solid fa-chevron-left mr-2"></i>Câu trước
                        </button>
                        <button id="btn-next" onclick="nextQuestion()" class="px-4 py-2.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 font-medium text-sm transition-all-fast flex items-center disabled:opacity-40 disabled:cursor-not-allowed">
                            Câu tiếp<i class="fa-solid fa-chevron-right ml-2"></i>
                        </button>
                    </div>

                    <div class="flex items-center space-x-2">
                        <!-- Reset current question button -->
                        <button id="btn-retry-single" onclick="retryCurrentQuestion()" class="hidden px-3.5 py-2.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-600 font-medium text-xs sm:text-sm transition-all-fast" title="Làm lại câu này">
                            <i class="fa-solid fa-rotate-left mr-1.5"></i>Làm lại câu này
                        </button>

                        <!-- Grade / Check Answer Button -->
                        <button id="btn-check-answer" onclick="checkCurrentAnswer()" class="px-5 py-2.5 rounded-lg bg-teal-600 hover:bg-teal-700 text-white font-semibold text-sm shadow-sm transition-all-fast flex items-center">
                            <i class="fa-solid fa-check-double mr-2"></i>Kiểm tra đáp án
                        </button>
                    </div>
                </div>

                <!-- EXPLANATION & RUBRIC PANEL -->
                <div id="explanation-box" class="hidden bg-white rounded-xl border-2 border-slate-200 shadow-md overflow-hidden transition-all">
                    <!-- Dynamic Header -->
                    <div id="explanation-header" class="px-5 py-3 flex flex-wrap items-center justify-between gap-2 border-b">
                        <div class="flex items-center space-x-2 font-bold text-sm sm:text-base">
                            <i id="explanation-icon" class="fa-solid fa-circle-check"></i>
                            <span id="explanation-status-text">Chính xác!</span>
                        </div>
                        <span id="explanation-correct-badge" class="text-xs font-bold px-2.5 py-1 rounded bg-white/80">
                            Đáp án đúng: A
                        </span>
                    </div>
                    
                    <div class="p-5 space-y-4 text-sm sm:text-base leading-relaxed text-slate-700">
                        
                        <!-- SAQ MODEL ANSWER & SELF-ASSESSMENT RUBRIC (Only shown for SAQ) -->
                        <div id="saq-model-answer-section" class="hidden space-y-4">
                            <div class="bg-purple-50 border border-purple-200 rounded-xl p-4">
                                <h4 class="font-bold text-purple-900 text-xs uppercase tracking-wider mb-1.5 flex items-center">
                                    <i class="fa-solid fa-award text-purple-600 mr-1.5"></i>Đáp án chuẩn (Model Answer)
                                </h4>
                                <p id="saq-model-answer-text" class="text-purple-950 font-semibold text-sm sm:text-base"></p>
                            </div>

                            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
                                <h4 class="font-bold text-slate-800 text-xs uppercase tracking-wider mb-2 flex items-center">
                                    <i class="fa-solid fa-clipboard-check text-teal-600 mr-1.5"></i>Tiêu chí chấm điểm (Rubric - Cần đạt các ý sau):
                                </h4>
                                <ul id="saq-rubric-list" class="space-y-1.5 text-sm text-slate-700 list-disc list-inside">
                                    <!-- Dynamic rubric points -->
                                </ul>

                                <!-- Self-assessment confirmation buttons -->
                                <div class="mt-4 pt-3 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2">
                                    <span class="text-xs font-bold text-slate-700">Tự đánh giá câu trả lời của bạn:</span>
                                    <div class="flex items-center space-x-2">
                                        <button id="btn-saq-pass" onclick="setSaqSelfGrade(true)" class="px-3.5 py-1.5 rounded-lg text-xs font-bold border transition-all-fast flex items-center">
                                            <i class="fa-solid fa-check mr-1.5"></i>Đạt yêu cầu
                                        </button>
                                        <button id="btn-saq-fail" onclick="setSaqSelfGrade(false)" class="px-3.5 py-1.5 rounded-lg text-xs font-bold border transition-all-fast flex items-center">
                                            <i class="fa-solid fa-xmark mr-1.5"></i>Chưa đạt
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Clinical Pathophysiology Explanation (For both MCQ and SAQ) -->
                        <div>
