                if (q.option_analysis) {
                    distractorsList.innerHTML = Object.entries(q.option_analysis).map(([key, analysis]) => {
                        const isRight = key === q.correct_answer;
                        return `
                            <li class="flex items-start space-x-2">
                                <span class="font-bold px-1.5 py-0.5 rounded text-xs mt-0.5 ${isRight ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-700'}">${key}</span>
