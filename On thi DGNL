        ];

        // =========================================================================
        // 3. QUẢN LÝ TRẠNG THÁI ỨNG DỤNG (STATE MANAGEMENT)
        // =========================================================================
        let allQuestions = [...DEFAULT_QUESTIONS];
        let filteredQuestions = [...allQuestions];
        let currentIndex = 0;
        let fontSizeLevel = 0; // -1, 0, 1, 2
        let highlightAbnormal = true;
        let showHint = false;

        // Per-question user state:
        // MCQ: { selected: 'A'|null, eliminated: [], checked: boolean, flagged: boolean }
        // SAQ: { text: '', checked: boolean, selfPassed: boolean|null, flagged: boolean }
        let userProgress = {};

        // Study Stopwatch (count-up)
        let elapsedSeconds = 0;
        let stopwatchInterval = null;
        let isStopwatchPaused = false;

        // =========================================================================
        // 4. KHỞI TẠO & RENDER GIAO DIỆN
        // =========================================================================
        function initApp() {
            initUserProgress();
            renderLabReferenceModal();
            renderCurrentQuestion();
            startStopwatch();
        }

        function initUserProgress() {
            allQuestions.forEach(q => {
                if (!userProgress[q.id]) {
                    userProgress[q.id] = {
                        selected: null,
                        eliminated: [],
                        text: "",
                        checked: false,
                        selfPassed: null,
                        flagged: false
                    };
                }
            });
        }

        function renderCurrentQuestion() {
            if (filteredQuestions.length === 0) return;

            const q = filteredQuestions[currentIndex];
            const state = userProgress[q.id];
            const isSaq = q.type === 'saq';

            // 1. Update Header Info & Live Score
            document.getElementById('question-counter').textContent = `Câu ${currentIndex + 1} / ${filteredQuestions.length}`;
            document.getElementById('current-q-id').textContent = `ID: #${q.id}`;
            updateLiveScoreBadge();

            // 2. Update Specialty & Question Type Badges
            const specBadge = document.getElementById('q-specialty-badge');
            specBadge.textContent = q.specialty;
            specBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border ";
            if (q.specialty === "Nội khoa") specBadge.className += "bg-blue-50 text-blue-700 border-blue-200";
            else if (q.specialty === "Ngoại khoa") specBadge.className += "bg-emerald-50 text-emerald-700 border-emerald-200";
            else if (q.specialty === "Sản phụ khoa") specBadge.className += "bg-pink-50 text-pink-700 border-pink-200";
            else if (q.specialty === "Nhi khoa") specBadge.className += "bg-amber-50 text-amber-700 border-amber-200";
            else specBadge.className += "bg-teal-50 text-teal-700 border-teal-200";

            const typeBadge = document.getElementById('q-type-badge');
            const qPillLabel = document.getElementById('question-pill-label');
            if (isSaq) {
                typeBadge.className = "px-2.5 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800 border border-purple-200";
                typeBadge.innerHTML = `<i class="fa-solid fa-pen-nib mr-1"></i>Tự luận ngắn (SAQ)`;
                qPillLabel.className = "bg-purple-700 text-white font-bold text-xs px-2.5 py-1 rounded mt-0.5 flex-shrink-0";
                qPillLabel.textContent = "TỰ LUẬN";
            } else {
                typeBadge.className = "px-2.5 py-1 rounded-full text-xs font-bold bg-sky-100 text-sky-800 border border-sky-200";
                typeBadge.innerHTML = `<i class="fa-solid fa-list-ul mr-1"></i>Trắc nghiệm (MCQ)`;
                qPillLabel.className = "bg-navy-900 text-white font-bold text-xs px-2.5 py-1 rounded mt-0.5 flex-shrink-0";
                qPillLabel.textContent = "TRẮC NGHIỆM";
            }

            document.getElementById('q-topic-tag').textContent = `Chủ đề: ${q.topic || q.specialty}`;

            // 3. Update Flag & Clinical Hint State
            const flagBtn = document.getElementById('btn-flag');
            if (state.flagged) {
                flagBtn.classList.add('bg-amber-100', 'border-amber-400', 'text-amber-900');
                flagBtn.innerHTML = `<i class="fa-solid fa-flag text-amber-600"></i><span>Đã cắm cờ</span>`;
            } else {
                flagBtn.classList.remove('bg-amber-100', 'border-amber-400', 'text-amber-900');
                flagBtn.innerHTML = `<i class="fa-regular fa-flag text-amber-600"></i><span>Cắm cờ xem lại</span>`;
            }

            // Reset hint visibility when switching questions
            showHint = false;
            updateHintBoxUI(q);

            // 4. Render Left Column: Clinical Vignette
            const vignetteContainer = document.getElementById('vignette-content');
            const paragraphs = q.vignette.split('\n').filter(p => p.trim() !== '');
            vignetteContainer.innerHTML = paragraphs.map(p => `<p>${p}</p>`).join('');

            // 5. Render Left Column: Labs Table
            renderLabsTable(q);

            // 6. Render Right Column: Lead-in Question (preserve line breaks)
            const leadInEl = document.getElementById('lead-in-question');
            leadInEl.innerHTML = q.question.replace(/\n/g, '<br>');

            // 7. Switch between MCQ Area and SAQ Area
            const mcqArea = document.getElementById('mcq-interaction-area');
            const saqArea = document.getElementById('saq-interaction-area');

            if (isSaq) {
                mcqArea.classList.add('hidden');
                saqArea.classList.remove('hidden');
                renderSaqArea(q, state);
            } else {
                saqArea.classList.add('hidden');
                mcqArea.classList.remove('hidden');
                renderMcqOptions(q, state);
            }

            // 8. Update Action Buttons (Prev, Next, Check Answer, Retry Single)
            document.getElementById('btn-prev').disabled = (currentIndex === 0);
            document.getElementById('btn-next').disabled = (currentIndex === filteredQuestions.length - 1);

            const checkBtn = document.getElementById('btn-check-answer');
            const retrySingleBtn = document.getElementById('btn-retry-single');

            if (state.checked) {
                checkBtn.classList.add('hidden');
                retrySingleBtn.classList.remove('hidden');
            } else {
                retrySingleBtn.classList.add('hidden');
                checkBtn.classList.remove('hidden');
                if (isSaq) {
                    checkBtn.className = "px-5 py-2.5 rounded-lg bg-purple-700 hover:bg-purple-800 text-white font-semibold text-sm shadow-sm transition-all-fast flex items-center";
                    checkBtn.innerHTML = `<i class="fa-solid fa-eye mr-2"></i>Chấm & Xem đáp án chuẩn`;
                } else {
                    checkBtn.className = "px-5 py-2.5 rounded-lg bg-teal-600 hover:bg-teal-700 text-white font-semibold text-sm shadow-sm transition-all-fast flex items-center";
                    checkBtn.innerHTML = `<i class="fa-solid fa-check-double mr-2"></i>Kiểm tra đáp án`;
                }
            }

            // 9. Render Explanation & Rubric Panel
            renderExplanationPanel(q, state);
            renderNavigator();
        }

        function renderLabsTable(q) {
            const labsContainer = document.getElementById('labs-container');
            const labsBody = document.getElementById('labs-table-body');

            // Update Highlight Toggle Button UI
            const toggleBtn = document.getElementById('btn-toggle-abnormal');
            const toggleText = document.getElementById('highlight-abnormal-text');
            if (highlightAbnormal) {
                toggleBtn.className = "text-xs px-2.5 py-1 rounded-md border font-medium transition-all-fast flex items-center bg-rose-50 border-rose-200 text-rose-700";
                toggleText.textContent = "Đang tô màu bất thường";
            } else {
                toggleBtn.className = "text-xs px-2.5 py-1 rounded-md border font-medium transition-all-fast flex items-center bg-white border-slate-300 text-slate-600";
                toggleText.textContent = "Tắt tô màu bất thường";
            }

            if (q.labs && q.labs.length > 0) {
                labsContainer.classList.remove('hidden');
                labsBody.innerHTML = q.labs.map(lab => {
                    let valueStyle = "text-slate-800 font-medium";
                    let badgeHtml = "";

                    if (highlightAbnormal) {
                        if (lab.abnormal === 'high') {
                            valueStyle = "text-rose-600 font-bold";
                            badgeHtml = `<i class="fa-solid fa-arrow-up text-rose-600 ml-1 text-[10px]"></i>`;
                        } else if (lab.abnormal === 'low') {
                            valueStyle = "text-blue-600 font-bold";
                            badgeHtml = `<i class="fa-solid fa-arrow-down text-blue-600 ml-1 text-[10px]"></i>`;
                        }
                    }

                    return `
                        <tr class="hover:bg-slate-100/70 transition-colors">
                            <td class="px-4 py-2.5 text-slate-700 font-sans font-medium">${lab.name}</td>
                            <td class="px-4 py-2.5 ${valueStyle}">${lab.value}${badgeHtml}</td>
                            <td class="px-4 py-2.5 text-slate-500 hidden sm:table-cell">${lab.ref || '-'}</td>
                        </tr>
                    `;
                }).join('');
            } else {
                labsContainer.classList.add('hidden');
            }
        }

        function renderMcqOptions(q, state) {
            const optionsList = document.getElementById('options-list');
            const showResult = state.checked;

            optionsList.innerHTML = Object.entries(q.options).map(([key, text]) => {
                const isSelected = state.selected === key;
                const isEliminated = state.eliminated.includes(key);
                const isCorrect = q.correct_answer === key;

                let cardClass = "group relative flex items-start justify-between p-4 rounded-xl border-2 cursor-pointer transition-all-fast select-none ";
                let circleClass = "w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs mr-3.5 mt-0.5 flex-shrink-0 border ";
                let statusIcon = "";

                if (showResult) {
                    if (isCorrect) {
                        cardClass += "bg-emerald-50/90 border-emerald-500 shadow-sm ";
                        circleClass += "bg-emerald-600 text-white border-emerald-600 ";
                        statusIcon = `<i class="fa-solid fa-circle-check text-emerald-600 text-lg ml-2 mt-0.5"></i>`;
                    } else if (isSelected && !isCorrect) {
                        cardClass += "bg-rose-50/90 border-rose-500 shadow-sm ";
                        circleClass += "bg-rose-600 text-white border-rose-600 ";
                        statusIcon = `<i class="fa-solid fa-circle-xmark text-rose-600 text-lg ml-2 mt-0.5"></i>`;
                    } else {
                        cardClass += "bg-white border-slate-200 opacity-75 ";
                        circleClass += "bg-slate-100 text-slate-600 border-slate-300 ";
                    }
                } else {
                    if (isSelected) {
                        cardClass += "bg-teal-50/70 border-teal-600 shadow-sm ";
                        circleClass += "bg-teal-600 text-white border-teal-600 ";
                    } else {
                        cardClass += "bg-white border-slate-200 hover:border-slate-400 hover:bg-slate-50/50 ";
                        circleClass += "bg-slate-100 text-slate-700 border-slate-300 group-hover:border-slate-400 ";
                    }
                }

                if (isEliminated && !showResult) {
                    cardClass += " option-eliminated ";
                }

                return `
                    <div onclick="selectMcqOption('${key}')" oncontextmenu="toggleEliminateOption(event, '${key}')" class="${cardClass}">
                        <div class="flex items-start flex-1">
                            <span class="${circleClass}">${key}</span>
                            <span class="option-text text-sm sm:text-base text-slate-800 leading-snug pt-0.5">${text}</span>
                        </div>
                        <div class="flex items-center space-x-1 ml-2">
                            ${statusIcon}
                            ${!showResult ? `
                                <button type="button" onclick="toggleEliminateOption(event, '${key}')" class="p-1.5 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-200/70 transition-colors" title="Gạch bỏ phương án này">
                                    <i class="fa-solid fa-strikethrough text-xs"></i>
                                </button>
                            ` : ''}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderSaqArea(q, state) {
            const textarea = document.getElementById('saq-user-input');
            textarea.value = state.text || "";
            textarea.disabled = state.checked;

            const kwContainer = document.getElementById('saq-keyword-feedback');
            const kwBadges = document.getElementById('saq-keyword-badges');

            if (state.checked && q.keywords && q.keywords.length > 0) {
                kwContainer.classList.remove('hidden');
                const normalizedInput = (state.text || "").toLowerCase();

                kwBadges.innerHTML = q.keywords.map(kw => {
                    const matched = normalizedInput.includes(kw.toLowerCase());
                    if (matched) {
                        return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200"><i class="fa-solid fa-check mr-1 text-[10px]"></i>${kw}</span>`;
                    } else {
                        return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-500 border border-slate-200"><i class="fa-solid fa-minus mr-1 text-[10px]"></i>Thiếu: ${kw}</span>`;
                    }
                }).join('');
            } else {
                kwContainer.classList.add('hidden');
            }
        }

        function renderExplanationPanel(q, state) {
            const expBox = document.getElementById('explanation-box');
            if (!state.checked) {
                expBox.classList.add('hidden');
                return;
            }

            expBox.classList.remove('hidden');
