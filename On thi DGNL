                    vignette: "Bệnh nhân nam 64 tuổi tiền sử COPD nhóm E nhập viện vì khó thở tăng dần, khạc đàm đục tăng số lượng từ 2 ngày nay. Khám: thở co kéo cơ hô hấp phụ, SpO2 85% (khí trời), phổi ran rít ran ngáy hai bên.",
                    labs: [
                        { name: "pH máu động mạch", value: "7.28 (Giảm)", ref: "7.35 - 7.45", abnormal: "low" },
                        { name: "PaCO2", value: "64 mmHg (Tăng)", ref: "35 - 45 mmHg", abnormal: "high" }
                    ],
                    hint: "Đợt cấp COPD nặng có toan hô hấp (pH < 7.35, PaCO2 > 45 mmHg) nhưng bệnh nhân còn tỉnh táo.",
                    question: "1) Nêu mục tiêu SpO2 cần duy trì ở bệnh nhân này.\n2) Phương thức hỗ trợ thông khí ưu tiên hàng đầu hiện tại là gì?",
                    model_answer: "1) Mục tiêu SpO2: 88 - 92%.\n2) Hỗ trợ thông khí ưu tiên: Thông khí nhân tạo không xâm nhập áp lực dương (NIV / BiPAP).",
                    keywords: ["88", "92", "không xâm nhập", "niv", "bipap"],
                    rubric: [
                        "Nêu đúng ngưỡng mục tiêu SpO2: 88 - 92% (tránh tăng CO2 máu nặng thêm).",
                        "Chỉ định đúng thông khí không xâm nhập (NIV / BiPAP) vì pH 7.25 - 7.35 và PaCO2 > 45 mmHg."
                    ],
                    explanation: "Ở bệnh nhân đợt cấp COPD có suy hô hấp tăng thán khí (pH < 7.35 và PaCO2 > 45 mmHg), thở oxy liều thấp kiểm soát SpO2 đạt 88-92% kết hợp thông khí không xâm nhập (NIV/BiPAP) giúp giảm công hô hấp và giảm tỷ lệ phải đặt nội khí quản.",
                    reference: "GOLD Report 2024 - Quản lý đợt cấp COPD."
                }
            ];
            document.getElementById('json-input-area').value = JSON.stringify(sample, null, 2);
            document.getElementById('json-error-msg').classList.add('hidden');
        }

        function importJsonQuestions() {
            const raw = document.getElementById('json-input-area').value.trim();
            const errBox = document.getElementById('json-error-msg');
            errBox.classList.add('hidden');

            if (!raw) {
                errBox.textContent = "Vui lòng dán dữ liệu JSON trước khi nạp đề.";
                errBox.classList.remove('hidden');
                return;
            }

            try {
                const parsed = JSON.parse(raw);
                const list = Array.isArray(parsed) ? parsed : [parsed];
                if (list.length === 0) throw new Error("Mảng JSON rỗng.");

                const validated = list.map((item, idx) => {
                    const qType = (item.type || "mcq").toLowerCase();
                    if (!item.vignette || !item.question) {
                        throw new Error(`Câu số ${idx + 1} thiếu trường vignette hoặc question.`);
                    }
                    if (qType === 'mcq' && (!item.options || !item.correct_answer)) {
                        throw new Error(`Câu trắc nghiệm số ${idx + 1} thiếu options hoặc correct_answer.`);
                    }
                    if (qType === 'saq' && !item.model_answer) {
                        throw new Error(`Câu tự luận ngắn số ${idx + 1} thiếu model_answer.`);
                    }

                    return {
                        id: item.id || `JSON-${idx + 1}`,
                        type: qType,
                        specialty: item.specialty || "Nội khoa",
                        topic: item.topic || "Tổng hợp",
                        vignette: item.vignette,
                        labs: Array.isArray(item.labs) ? item.labs : [],
                        hint: item.hint || "",
                        question: item.question,
                        options: item.options || {},
                        correct_answer: (item.correct_answer || "").toUpperCase(),
                        model_answer: item.model_answer || "",
                        keywords: Array.isArray(item.keywords) ? item.keywords : [],
                        rubric: Array.isArray(item.rubric) ? item.rubric : [],
                        explanation: item.explanation || "Chưa có giải thích chi tiết.",
                        option_analysis: item.option_analysis || null,
                        reference: item.reference || "Tài liệu y khoa cập nhật."
                    };
                });

                allQuestions = validated;
                filteredQuestions = [...allQuestions];
                document.getElementById('specialty-filter').value = 'ALL';
                document.getElementById('type-filter').value = 'ALL';
                userProgress = {};
                initUserProgress();
                currentIndex = 0;
                elapsedSeconds = 0;
                updateStopwatchDisplay();
                renderCurrentQuestion();
                closeModal('import-modal');
                showToast(`Đã nạp thành công ${validated.length} câu hỏi luyện thi mới!`, "info");

            } catch (err) {
                errBox.textContent = "Lỗi định dạng JSON: " + err.message;
                errBox.classList.remove('hidden');
            }
        }

        function resetToDefaultQuestions() {
            allQuestions = [...DEFAULT_QUESTIONS];
            filteredQuestions = [...allQuestions];
            document.getElementById('specialty-filter').value = 'ALL';
            document.getElementById('type-filter').value = 'ALL';
            userProgress = {};
            initUserProgress();
            currentIndex = 0;
            elapsedSeconds = 0;
            updateStopwatchDisplay();
            renderCurrentQuestion();
            closeModal('import-modal');
            showToast("Đã khôi phục 8 câu hỏi mẫu (4 Trắc nghiệm + 4 Tự luận ngắn).", "info");
        }

        // =========================================================================
        // 10. TIỆN ÍCH MODAL, TOAST & PHÍM TẮT BÀN PHÍM
        // =========================================================================
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        let toastTimeout = null;
        function showToast(message, type = "info") {
            const toast = document.getElementById('toast-notification');
            const icon = document.getElementById('toast-icon');
            const msgEl = document.getElementById('toast-message');

            msgEl.textContent = message;
            icon.className = type === 'warning' 
                ? "fa-solid fa-triangle-exclamation text-amber-400" 
                : "fa-solid fa-circle-info text-teal-400";

            toast.classList.remove('translate-y-20', 'opacity-0');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3200);
        }

        document.addEventListener('keydown', (e) => {
            if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;

            const currentQ = filteredQuestions[currentIndex];
            if (!currentQ) return;

            if (e.key === 'ArrowRight') nextQuestion();
            else if (e.key === 'ArrowLeft') prevQuestion();
            else if (currentQ.type === 'mcq') {
                if (['a', 'A', '1'].includes(e.key)) selectMcqOption('A');
                else if (['b', 'B', '2'].includes(e.key)) selectMcqOption('B');
                else if (['c', 'C', '3'].includes(e.key)) selectMcqOption('C');
                else if (['d', 'D', '4'].includes(e.key)) selectMcqOption('D');
            }
            if (e.key === 'Enter' && !userProgress[currentQ.id].checked) {
                checkCurrentAnswer();
            }
        });

        window.onload = initApp;
    </script>
</body>
</html>
