        // =========================================================================
        // 2. DỮ LIỆU TRA CỨU GIÁ TRỊ THAM CHIẾU XÉT NGHIỆM (LAB VALUES MODAL)
        // =========================================================================
        const LAB_REFERENCE_DATA = [
            {
                category: "Huyết học & Đông máu",
                items: [
